# Copy to deploy/backup.env on the server (chmod 600). Used by backup.sh and
# restore_check.sh. RESTIC_PASSWORD_FILE holds the repository password: losing
# it loses every backup, so keep a copy in the password manager (two holders).
POSTGRES_DB=lottery_passport
POSTGRES_USER=lottery_passport
RESTIC_REPOSITORY=s3:https://CHANGE-object-storage-endpoint/lottery-passport-backups
RESTIC_PASSWORD_FILE=/etc/lottery-passport/restic-password
AWS_ACCESS_KEY_ID=CHANGE
AWS_SECRET_ACCESS_KEY=CHANGE
DUMP_DIR=/var/backups/lottery-passport
# Push URL of an uptime-monitor "heartbeat" check; alerts if backups stop.
HEARTBEAT_URL=
