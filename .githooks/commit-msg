#!/usr/bin/env python3
"""Require literal gitmoji prefixes and Conventional Commit subjects (stdlib only)."""

import re
import sys
from pathlib import Path

# Repository-approved gitmojis; keep the README policy in sync.
GITMOJIS = "✨ 🐛 ♻ 📝 ✅ 👷 🔥 🎨 ⚡ 🔒 🚧 ⬆ 🔧 ⏪ 🎉 🚀 💚 📦 🧪 🛠 💄 🌐 🗑 🩹 🔐".split()
TYPES = (
    "feat", "fix", "refactor", "docs", "test", "ci", "chore", "style", "build",
    "perf", "security", "wip", "deps", "config", "revert",
    # added to pair with the extended gitmoji set
    "ui", "i18n", "remove", "hotfix", "auth", "init", "release", "fix-ci", "experiment", "drop",
)
EMOJI = "(?:" + "|".join(map(re.escape, GITMOJIS)) + ")\ufe0f?"
SUBJECT = re.compile(
    rf"(?:{EMOJI} *)+ (?:{'|'.join(TYPES)})"
    r"(?:\([a-z0-9][a-z0-9._/-]*\))?!?: \S(?:.*\S)?"
)
HELP = (
    "Invalid commit subject: require one or more approved literal gitmojis, "
    "a conventional type, and a description.\n"
    "Format: <gitmoji> [<gitmoji> ...] <type>[(scope)][!]: <description>\n"
    "Example: ✨ feat(auth): add login\n"
    "Example: 🔧 ✅ chore(hooks): enforce commit messages\n"
    "See README.md: Commit messages."
)


def main():
    if len(sys.argv) != 2:
        print("Usage: commit-msg <message-file>", file=sys.stderr)
        return 1
    try:
        lines = Path(sys.argv[1]).read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError):
        print("Cannot read UTF-8 commit message file.", file=sys.stderr)
        return 1
    if not lines or SUBJECT.fullmatch(lines[0]) is None:
        print(HELP, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
